# DHRUVA frontend — copy to .env.local and fill in once the Phase 3+ backend exists.
#
# Leave unset (or delete) to run entirely against the bundled mock fixtures in
# src/shared/api/mock.ts — this is the default and needs no backend at all.
#
# SECURITY: only put values here that are safe to ship to every visitor's
# browser. Vite inlines every VITE_-prefixed variable into the public JS
# bundle. Never put BHASHINI_ULCA_API_KEY, BHASHINI_USER_ID, or any other
# backend secret in this file or in any VITE_ variable — those stay in the
# backend's own .env (see ../.env.example) and are called through this app's
# backend, never directly from the browser. See shared/voice/speech.ts.

# Base URL of the real DHRUVA backend, once it exists, e.g. http://localhost:8000
VITE_API_BASE_URL=
