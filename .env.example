# DHRUVA — copy to .env and fill. Never commit .env.
#
# Values containing any of  space " ' $ & ; # = ^ { } | < > * ? ! \ ` ~
# MUST be single-quoted: 'p@ss$word'. Docker Compose interpolates a bare $,
# and the shell chokes on an unmatched quote. Comments get their own line —
# a trailing "# ..." after a value is parsed inconsistently across tools.

# --- Models ---
# Gemini 2.5 Flash for planning
OPENROUTER_API_KEY=
# Indic narration + Saarika ASR / Bulbul TTS
SARVAM_API_KEY=

# --- Language ---
# ULCA; auth is a config call that returns the real endpoint and key
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# --- Data sources ---
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
# PACE enrichment only. Either username+password, or EARTHDATA_TOKEN alone
# (earthaccess accepts both via strategy="environment").
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=
# INCOIS ERDDAP and Open-Meteo need no key.
INCOIS_ERDDAP_BASE=https://erddap.incois.gov.in/erddap
OPEN_METEO_MARINE_BASE=https://marine-api.open-meteo.com/v1
# INCOIS omits an intermediate cert; pin the bundle, never disable verification.
INCOIS_CA_BUNDLE=./data/ca/incois-bundle.pem

# --- Infra ---
POSTGRES_USER=dhruva
POSTGRES_PASSWORD=
POSTGRES_DB=dhruva
DATABASE_URL=postgresql+asyncpg://dhruva:@postgres:5432/dhruva
REDIS_URL=redis://redis:6379/0

# --- Observability (generated inside the Langfuse UI, not registered) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
# Locally generated, e.g. openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=

# --- host port bindings (containers always use the internal ports) ---
# Defaults avoid colliding with other projects on this machine.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
API_HOST_PORT=8000
CADDY_HOST_PORT=8081
LANGFUSE_HOST_PORT=3000
