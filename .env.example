# DHRUVA — copy to .env and fill. Never commit .env.

# --- Models ---
OPENROUTER_API_KEY=            # Gemini 2.5 Flash for planning
SARVAM_API_KEY=                # Indic narration + Saarika ASR / Bulbul TTS

# --- Language ---
BHASHINI_USER_ID=              # ULCA; auth is config-call-then-compute-call
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# --- Data sources ---
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
EARTHDATA_USERNAME=            # only if PACE enrichment is in scope
EARTHDATA_PASSWORD=
# INCOIS ERDDAP and Open-Meteo need no key.
INCOIS_ERDDAP_BASE=https://erddap.incois.gov.in/erddap
OPEN_METEO_MARINE_BASE=https://marine-api.open-meteo.com/v1
# Pin the CA bundle for INCOIS; never disable verification.
INCOIS_CA_BUNDLE=./data/ca/incois-bundle.pem

# --- Infra ---
POSTGRES_USER=dhruva
POSTGRES_PASSWORD=
POSTGRES_DB=dhruva
DATABASE_URL=postgresql+asyncpg://dhruva:@postgres:5432/dhruva
REDIS_URL=redis://redis:6379/0

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000

# --- host port bindings (containers always use the internal ports) ---
# Defaults avoid colliding with other projects on this machine.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
API_HOST_PORT=8000
CADDY_HOST_PORT=8081
LANGFUSE_HOST_PORT=3000
